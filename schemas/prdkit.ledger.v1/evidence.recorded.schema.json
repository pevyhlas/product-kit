{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pevyhlas/product-kit/schemas/prdkit.ledger.v1/evidence.recorded.schema.json",
  "title": "prdkit.ledger.v1 evidence.recorded",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "properties": {
    "event": { "const": "evidence.recorded" },
    "payload": {
      "type": "object",
      "required": ["gates"],
      "properties": {
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["gate", "result"],
            "properties": {
              "gate": { "type": "string" },
              "result": { "enum": ["PASS", "FAIL", "N/A"] }
            }
          }
        }
      }
    }
  }
}
