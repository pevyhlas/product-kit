{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pevyhlas/product-kit/schemas/prdkit.ledger.v1/feature.merged.schema.json",
  "title": "prdkit.ledger.v1 feature.merged",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "properties": {
    "event": { "const": "feature.merged" },
    "payload": {
      "type": "object",
      "required": ["tasks_total"],
      "properties": {
        "tasks_total": { "type": "integer", "minimum": 0 },
        "spec_files_changed": { "type": "integer", "minimum": 0 },
        "spec_insertions": { "type": "integer", "minimum": 0 },
        "spec_deletions": { "type": "integer", "minimum": 0 },
        "duration_days": { "type": "number", "minimum": 0 }
      }
    }
  }
}
