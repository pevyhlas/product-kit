{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pevyhlas/product-kit/schemas/prdkit.ledger.v1/exploration.converged.schema.json",
  "title": "prdkit.ledger.v1 exploration.converged",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "properties": {
    "event": { "const": "exploration.converged" },
    "payload": {
      "type": "object",
      "required": ["task", "convergence"],
      "properties": {
        "task": { "type": "string", "pattern": "^T[0-9]+$" },
        "convergence": { "enum": ["HIGH", "MEDIUM", "LOW"] },
        "passes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
