{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pevyhlas/product-kit/schemas/prdkit.ledger.v1/review.recorded.schema.json",
  "title": "prdkit.ledger.v1 review.recorded",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "properties": {
    "event": { "const": "review.recorded" },
    "payload": {
      "type": "object",
      "required": ["scope", "verdict"],
      "properties": {
        "scope": { "enum": ["task", "batch", "feature"] },
        "task": { "type": "string", "description": "Task id for scope task; omitted for scope feature." },
        "tasks": { "type": "array", "items": { "type": "string" }, "description": "Covered task ids for scope batch." },
        "domain": { "type": "string", "description": "Review domain for scope feature, e.g. Security & Privacy." },
        "round": { "type": "integer", "minimum": 1 },
        "verdict": { "enum": ["PASS", "FAIL", "WAIVED"] },
        "findings": {
          "type": "object",
          "properties": {
            "critical": { "type": "integer", "minimum": 0 },
            "high": { "type": "integer", "minimum": 0 },
            "medium": { "type": "integer", "minimum": 0 },
            "low": { "type": "integer", "minimum": 0 }
          }
        },
        "waived": { "type": "boolean" },
        "batched": { "type": "boolean" },
        "agent": { "type": "string", "description": "Reviewer agent name from the project agents registry." }
      }
    }
  }
}
